<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="hotel.view.MainView">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="ad447" binding="menuPanel" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="30">
        <margin top="25" left="20" bottom="40" right="20"/>
        <constraints border-constraint="West"/>
        <properties>
          <background color="-14469301"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="d5723" class="javax.swing.JLabel" binding="lblTitel">
            <constraints>
              <grid row="0" column="0" row-span="2" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="16" style="1"/>
              <foreground color="-1"/>
              <horizontalAlignment value="0"/>
              <name value=""/>
              <text value="  Sistema de Hoteleria  "/>
            </properties>
          </component>
          <component id="563e2" class="javax.swing.JButton" binding="btnRooms">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14469301"/>
              <font size="12" style="1"/>
              <foreground color="-1"/>
              <text value="HABITACIONES"/>
            </properties>
          </component>
          <component id="2acc2" class="javax.swing.JButton" binding="btnReservations">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14469301"/>
              <font size="12" style="1"/>
              <foreground color="-1"/>
              <text value="RESERVAS"/>
            </properties>
          </component>
          <component id="110ad" class="javax.swing.JButton" binding="btnExit">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14469301"/>
              <font size="12" style="1"/>
              <foreground color="-1"/>
              <hideActionText value="false"/>
              <text value="SALIR"/>
            </properties>
          </component>
          <component id="395a7" class="javax.swing.JButton" binding="btnClients">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14469301"/>
              <font size="12" style="1"/>
              <foreground color="-1"/>
              <text value="CLIENTES"/>
            </properties>
          </component>
          <vspacer id="f028a">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
        </children>
      </grid>
      <grid id="416fc" binding="contentPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
    </children>
  </grid>
</form>
